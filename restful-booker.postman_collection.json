                  "const j=pm.response.json(); pm.test('Booking schema',()=>{pm.expect(j.firstname).to.be.a('string');pm.expect(j.totalprice).to.be.a('number');pm.expect(j.bookingdates).to.have.keys('checkin','checkout');});"
                ]
