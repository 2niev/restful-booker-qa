{
  "info": {
    "name": "Restful Booker QA",
    "description": "Automated positive and negative checks for the endpoints in the test assignment. Run folders in order. Requests only modify bookings created by this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://restful-booker.herokuapp.com"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "runStamp",
      "value": ""
    },
    {
      "key": "testFirst",
      "value": ""
    },
    {
      "key": "testLast",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runStamp')) { const s = Date.now().toString(); pm.collectionVariables.set('runStamp', s); pm.collectionVariables.set('testFirst', 'QA' + s); pm.collectionVariables.set('testLast', 'Candidate' + s); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "AUTH-01 Valid credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const j=pm.response.json(); pm.test('Token returned',()=>pm.expect(j.token).to.be.a('string').and.not.empty); pm.collectionVariables.set('token',j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "AUTH-02 Invalid password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{username}}\",\"password\":\"wrong\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Bad credentials returned',()=>pm.expect(pm.response.json().reason).to.eql('Bad credentials')); "
                ]
              }
            }
          ]
        },
        {
          "name": "AUTH-03 Missing password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{username}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('No token issued',()=>pm.expect(pm.response.json()).to.not.have.property('token')); "
                ]
              }
            }
          ]
        }
      ]
    },
