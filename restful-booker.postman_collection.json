              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const ids=pm.response.json().map(x=>x.bookingid); pm.test('Created ID returned',()=>pm.expect(ids).to.include(Number(pm.collectionVariables.get('bookingId'))));"
                ]
              }
            }
          ]
